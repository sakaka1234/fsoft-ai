# Copy file này thành .env rồi điền giá trị thật.
#   cp .env.example .env
# .env đã nằm trong .gitignore — TUYỆT ĐỐI không commit.
#
# QUY TẮC BẮT BUỘC khi sửa file này: biến để TRỐNG thì chú thích phải nằm ở
# DÒNG RIÊNG phía trên. Viết `AI_FOO=   # giải thích` sẽ khiến python-dotenv
# lấy nguyên chuỗi `# giải thích` làm GIÁ TRỊ chứ không phải chuỗi rỗng — và
# vì nó vẫn "có giá trị" nên mọi chốt kiểu `if not settings.ai_foo` đều mất
# tác dụng, hỏng rất khó lần. Biến CÓ giá trị thì chú thích cùng dòng vẫn an
# toàn. `tests/test_config.py` canh luật này.

# ---- Service ----
AI_SERVICE_PORT=8000
# Đổi thành chuỗi ngẫu nhiên trước khi chạy thật:
#   python -c "import secrets;print(secrets.token_hex(32))"
AI_INTERNAL_TOKEN=dev-token
AI_LOG_LEVEL=INFO

# ---- Lưu trữ ----
AI_DB_PATH=./data/fsoft-ai.db           # Railway: /data/fsoft-ai.db (gắn volume)

# ---- Nguồn dữ liệu ----
AI_SOURCE_MODE=fixture                  # fixture | http
AI_FIXTURE_PATH=tests/fixtures/cards.json
AI_BACKEND_URL=https://fsoft-project-production.up.railway.app/fsoft
# X-Internal-Token gửi SANG backend Java. KHÁC với AI_INTERNAL_TOKEN ở trên:
# cái trên để backend gọi vào đây, cái này để đây gọi sang backend.
AI_BACKEND_TOKEN=
AI_BACKEND_TIMEOUT_SECONDS=20
AI_BACKEND_PAGE_SIZE=200

# ---- Đồng bộ ----
AI_SYNC_ENABLED=true
AI_SYNC_INTERVAL_SECONDS=120
AI_SYNC_OVERLAP_SECONDS=5               # chống bỏ sót ở ranh giới trang
AI_FULL_SWEEP_INTERVAL_SECONDS=3600     # quét ID phát hiện thẻ bị xoá

# ---- Embedding ----
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Biến thể ONNX. Đỉnh RSS đo được, cùng Recall@5 = 0.971 ở cả bốn:
#   onnx/model_tia113k.onnx            317 MB   <- mặc định
#   onnx/model_qint8_avx512_vnni.onnx  538 MB
#   onnx/model_O4.onnx                 697 MB
#   onnx/model.onnx                    936 MB
#
# Bản `tia113k` KHÔNG có trên Hugging Face — `scripts/tia_vocab.py` sinh ra nó
# bằng cách tỉa bảng từ vựng 250k xuống 113k, và Dockerfile chạy script đó lúc
# build. Muốn có nó trên máy dev:
#   uv run python scripts/tia_vocab.py --ngan-sach 120000 --ten tia113k
#
# ĐỔI GIÁ TRỊ NÀY LÀ PHẢI ĐỔI KÈM AI_MIN_SCORE và AI_MODEL_VERSION:
#   onnx/model_tia113k.onnx            ->  AI_MIN_SCORE=0.8344
#   onnx/model_qint8_avx512_vnni.onnx  ->  AI_MIN_SCORE=0.8344
#   onnx/model.onnx                    ->  AI_MIN_SCORE=0.83
# Sai cặp thì cổng lọc liên quan sai âm thầm, không có lỗi nào báo.
AI_EMBEDDING_MODEL_FILE=onnx/model_tia113k.onnx
AI_EMBEDDING_DIM=384
AI_MODEL_VERSION=e5-small-q8-tia113k@t1
# Tắt bộ cấp phát arena của ONNX Runtime: tiết kiệm ~47 MB RSS, độ trễ không đổi.
AI_ONNX_CPU_ARENA=false
AI_QUERY_PREFIX="query: "
AI_PASSAGE_PREFIX="passage: "
AI_EMBED_BATCH_SIZE=32
AI_EMBED_MAX_TOKENS=512
FASTEMBED_CACHE_PATH=./.cache/fastembed  # dev local; trong Docker là /opt/fastembed_cache
OMP_NUM_THREADS=1                        # giới hạn BLAS của numpy. Có tác dụng thật.
ORT_NUM_THREADS=1                        # KHÔNG điều khiển ONNX Runtime. Giữ cho vô hại.
# Số luồng ONNX Runtime, truyền qua SessionOptions — đây mới là đường đúng.
# 0 = để ORT tự quyết, và nó quyết theo số nhân MÁY CHỦ chứ không theo giới hạn
# CPU của container. Docker đặt 1; máy dev để 0 cho nhanh (1 luồng chậm hơn 2,1
# lần trên máy 16 nhân).
AI_ORT_INTRA_OP_THREADS=0

# ---- Retrieval ----
AI_TOP_K=3
AI_LEXICAL_CANDIDATES=20
AI_SEMANTIC_CANDIDATES=20
AI_RRF_K=60
AI_MIN_SCORE=0.8344                     # PHẢI khớp AI_EMBEDDING_MODEL_FILE ở trên
AI_INTENT_THRESHOLD=0.50                # KHÔNG dùng như ngưỡng tuyệt đối, xem M0_FINDINGS 2.5
AI_INTENT_MIN_MARGIN=0.01               # biên độ giữa hạng nhất và hạng nhì khi phân loại intent

# ---- LLM ----
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq API key, dạng gsk_... Để trống thì service vẫn khởi động và ba nhánh
# 0 token vẫn chạy; chỉ nhánh RAG là không dùng được.
AI_LLM_API_KEY=
AI_MODEL_CHAT=llama-3.3-70b-versatile   # LẤY TỪ docs/M0_FINDINGS.md
AI_MODEL_REWRITE=llama-3.1-8b-instant
AI_MODEL_QUIZ=llama-3.3-70b-versatile
AI_MODEL_FALLBACK=llama-3.1-8b-instant
AI_MAX_OUTPUT_TOKENS=400
AI_TEMPERATURE=0.3
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_RETRIES=2

# ---- Ngân sách token ----
AI_GLOBAL_TOKENS_PER_MINUTE=9600        # 80% của 12.000 TPM đo được ở M0
AI_HISTORY_MAX_MESSAGES=6
AI_CONTEXT_MAX_CHARS_PER_FIELD=300

# ---- Cache ----
AI_SEMANTIC_CACHE_ENABLED=true
AI_SEMANTIC_CACHE_THRESHOLD=0.97
AI_SEMANTIC_CACHE_MAX_SIZE=500
AI_SEMANTIC_CACHE_TTL_HOURS=24

# ---- Quiz ----
AI_QUIZ_DISTRACTOR_MAX_COSINE=0.92
AI_QUIZ_LLM_BATCH_SIZE=5

# ---- Demo mode ----
AI_DEMO_MODE=false                      # true: hạ ngưỡng cache xuống 0.90
